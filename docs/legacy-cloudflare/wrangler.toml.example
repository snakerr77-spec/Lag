name = "lag-controller"
compatibility_date = "2026-08-01"
pages_build_output_dir = "."

[[d1_databases]]
binding = "DB"
database_name = "lag-controller-db"
database_id = "COLE_O_DATABASE_ID"

[[r2_buckets]]
binding = "CANDIDATE_FILES"
bucket_name = "lag-candidate-files"

[[r2_buckets]]
binding = "PARTNER_FILES"
bucket_name = "lag-partner-files"

[vars]
# Opcional. Quando configurado, o formulário público exigirá Turnstile.
# TURNSTILE_SECRET deve ser cadastrado como segredo, não como texto no arquivo.
