{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lag-controller",
  "compatibility_date": "2026-08-07",
  "pages_build_output_dir": "./public",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lag-controller-db",
      "database_id": "6bb01193-c1f7-45af-80b2-0e31f826af52"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CANDIDATE_FILES",
      "bucket_name": "lag-candidate-files"
    },
    {
      "binding": "PARTNER_FILES",
      "bucket_name": "lag-partner-files"
    }
  ]
}
